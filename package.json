{
  "name": "spark-e2e",
  "version": "0.3.0",
  "description": "VLM-powered visual E2E testing for the web — one command per action, no server needed. Works with Claude Code, Codex, Qoder, Trae.",
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "spark-e2e": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "skills/",
    ".claude-plugin/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src-ts/cli.ts",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js",
    "test": "vitest run"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "codex",
    "qoder",
    "trae",
    "e2e",
    "testing",
    "visual",
    "vlm",
    "browser",
    "ui-review",
    "visual-testing",
    "screenshot",
    "ai-agent",
    "agent-skills",
    "typescript"
  ],
  "license": "MIT",
  "author": "neil-ji",
  "homepage": "https://github.com/neilji/spark-e2e#readme",
  "bugs": {
    "url": "https://github.com/neilji/spark-e2e/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/spark-e2e.git"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "provenance": "true"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.80.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
