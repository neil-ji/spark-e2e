# spark-e2e — VLM-powered visual E2E testing
# Copy this file to .env and fill in your values.

SPARK_E2E_API_KEY=your-api-key-here
SPARK_E2E_BASE_URL=https://your-vlm-endpoint.example.com/v1
SPARK_E2E_MODEL=gpt-4o

# Backward-compatible legacy vars (still work, but SPARK_E2E_ prefix is preferred)
# VLM_API_KEY=your-api-key-here
# VLM_BASE_URL=https://your-vlm-endpoint.example.com/v1
# VLM_MODEL=gpt-4o
